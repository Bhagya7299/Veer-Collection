# ========================================================
# VEER GARMENTS - NOTIFICATION & OTP CONFIGURATION
# ========================================================

PORT=5001

# --- EMAIL OTP (Gmail or Custom SMTP) ---
# To send real OTPs to user's Email inbox:
# 1. Use your Gmail account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your email and app password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Veer Garments <noreply@veergarments.com>"

# --- SMS OTP (Fast2SMS for Indian Mobile Numbers) ---
# 1. Sign up for free at: https://www.fast2sms.com
# 2. Copy your API Key from Dev API tab
FAST2SMS_API_KEY=

# --- OPTIONAL: SMS OTP (Twilio for Global SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

